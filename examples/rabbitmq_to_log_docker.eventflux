-- ============================================================================
-- EventFlux Example: RabbitMQ Source → Log Sink (Docker Compose)
-- ============================================================================
--
-- This example is configured for running inside Docker Compose.
-- It uses 'rabbitmq', the Docker service name, as the hostname instead of 'localhost'.
--
-- ============================================================================
-- RUNNING WITH DOCKER COMPOSE
-- ============================================================================
--
-- 1. Start the stack:
--    docker compose up -d
--
-- 2. Wait for services to be healthy:
--    docker compose ps
--
-- 3. Create the queue in the RabbitMQ Management UI (http://localhost:15672).
--    This step is optional. The source creates a missing queue by default.
--    - Go to "Queues" → "Add a new queue"
--    - Name: event-queue
--    - Click "Add queue"
--
-- 4. Run EventFlux, if docker compose has not started it already:
--    docker compose run --rm --no-deps eventflux /app/queries/rabbitmq_to_log_docker.eventflux
--
-- 5. Publish test messages in the RabbitMQ Management UI:
--    - Go to "Queues" → "event-queue" → "Publish message"
--    - Payload {"id":"evt-001","name":"temperature","value":23.5}
--
-- 6. View logs:
--    docker compose logs -f eventflux
--
-- ============================================================================

-- Input stream. Reads JSON events from a RabbitMQ queue.
-- The host 'rabbitmq' is the Docker Compose service name.
CREATE STREAM EventInput (
    id STRING,
    name STRING,
    value DOUBLE
) WITH (
    type = 'source',
    extension = 'rabbitmq',
    format = 'json',
    "rabbitmq.host" = 'rabbitmq',
    "rabbitmq.port" = '5672',
    "rabbitmq.queue" = 'event-queue',
    "rabbitmq.username" = 'guest',
    "rabbitmq.password" = 'guest'
);

-- Output stream. Logs events to the console.
CREATE STREAM EventOutput (
    id STRING,
    name STRING,
    value DOUBLE
) WITH (
    type = 'sink',
    extension = 'log',
    format = 'json'
);

-- Forward every event to the log sink.
INSERT INTO EventOutput
SELECT id, name, value
FROM EventInput;
