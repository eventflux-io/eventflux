-- EventFlux advanced demo. Live Bitcoin trend detection.
--
-- Uses PATTERN matching to spot changes in market activity and price.
--
-- Flow
--   RawTrades (source) ─> ActivityStats (internal) ─┬─> ActivityPulse (sink)
--                                                   └─> TrendSignal (sink)
--
-- What it shows
--   - WebSocket source with live Bitcoin trades
--   - Tumbling window aggregation over 10 second periods
--   - CAST to turn the VARCHAR price into a DOUBLE
--   - PATTERN with EVERY to keep matching trends
--   - A pattern over one stream (e1=Stream -> e2=Stream)
--   - Arithmetic in pattern queries (e2.count - e1.count)
--   - Several queries chained into a pipeline

-- =============================================================================
-- STREAMS
-- =============================================================================

-- Source. Live BTC/USDT trades from Binance. No API key needed.
CREATE STREAM RawTrades (
    price VARCHAR,
    quantity VARCHAR,
    symbol VARCHAR,
    trade_time BIGINT
) WITH (
    type = 'source',
    extension = 'websocket',
    format = 'json',
    "websocket.url" = 'wss://stream.binance.com:9443/ws/btcusdt@trade',
    "websocket.reconnect" = 'true',
    "websocket.reconnect.max.attempts" = '-1',
    "json.mapping.price" = '$.p',
    "json.mapping.quantity" = '$.q',
    "json.mapping.symbol" = '$.s',
    "json.mapping.trade_time" = '$.T'
);

-- Internal. Trade count and average price for each 10 second period.
-- Query 1 fills it from RawTrades.
CREATE STREAM ActivityStats (
    symbol VARCHAR,
    trade_count BIGINT,
    avg_price DOUBLE,
    period_end BIGINT
);

-- Sink 1. Logs the trade count and average price of each 10 second period.
CREATE STREAM ActivityPulse (
    symbol VARCHAR,
    trades BIGINT,
    avg_price DOUBLE
) WITH (
    type = 'sink',
    extension = 'log',
    format = 'json',
    "log.prefix" = '[PULSE]'
);

-- Sink 2. Logs activity and price trends.
-- Compares each 10 second period with the one before it.
CREATE STREAM TrendSignal (
    symbol VARCHAR,
    prev_trades BIGINT,
    curr_trades BIGINT,
    activity_change BIGINT,
    prev_price DOUBLE,
    curr_price DOUBLE,
    price_change_pct DOUBLE
) WITH (
    type = 'sink',
    extension = 'log',
    format = 'json',
    "log.prefix" = '[TREND]'
);

-- =============================================================================
-- QUERIES
-- =============================================================================

-- Query 1. Group raw trades into 10 second tumbling windows.
-- Counts trades per period and averages the price.
-- The price arrives as VARCHAR, so CAST turns it into DOUBLE first.
INSERT INTO ActivityStats
SELECT
    symbol,
    COUNT(*) AS trade_count,
    AVG(CAST(price AS DOUBLE)) AS avg_price,
    MAX(trade_time) AS period_end
FROM RawTrades
WINDOW('tumbling', INTERVAL '10' SECOND)
GROUP BY symbol;

-- Query 2. Forward each period to the pulse sink.
INSERT INTO ActivityPulse
SELECT
    symbol,
    trade_count AS trades,
    avg_price
FROM ActivityStats;

-- Query 3. Trend detection with a pattern.
-- PATTERN with EVERY matches each pair of back to back 10 second periods.
-- It shows whether activity and price are going up or down.
--
-- Pattern EVERY (e1=ActivityStats -> e2=ActivityStats)
-- - e1 is the previous period
-- - e2 is the current period
-- - EVERY starts a new match after each match, so matching never stops
--
-- SEQUENCE would force strictly back to back events, but today it matches
-- only once. Use PATTERN with EVERY to keep matching.
--
-- Output columns
--   prev_trades       trade count in the previous 10 second period
--   curr_trades       trade count in the current 10 second period
--   activity_change   curr minus prev. Positive means activity is rising.
--   prev_price        average price in the previous period
--   curr_price        average price in the current period
--   price_change_pct  percent change. Positive means the price is rising.
INSERT INTO TrendSignal
SELECT
    e2.symbol AS symbol,
    e1.trade_count AS prev_trades,
    e2.trade_count AS curr_trades,
    e2.trade_count - e1.trade_count AS activity_change,
    e1.avg_price AS prev_price,
    e2.avg_price AS curr_price,
    ((e2.avg_price - e1.avg_price) / e1.avg_price) * 100.0 AS price_change_pct
FROM PATTERN (EVERY (e1=ActivityStats -> e2=ActivityStats));
