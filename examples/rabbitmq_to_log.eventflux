-- ============================================================================
-- EventFlux Example: RabbitMQ Source → Log Sink
-- ============================================================================
--
-- A simple example that reads events from RabbitMQ and logs them to the console.
-- Handy for development and debugging.
--
-- ============================================================================
-- PREREQUISITES
-- ============================================================================
--
-- 0. Build EventFlux with the RabbitMQ connector enabled:
--
--    cargo build --release --features rabbitmq
--    (Docker images include all connectors already)
--
-- 1. Start RabbitMQ with Docker:
--
--    docker run -d --name rabbitmq \
--      -p 5672:5672 \
--      -p 15672:15672 \
--      rabbitmq:3-management
--
-- 2. Create the input queue in the Management UI (http://localhost:15672).
--    This step is optional. The source creates a missing queue by default.
--    - Username: guest, Password: guest
--    - Go to "Queues" → "Add a new queue"
--    - Name: event-queue
--    - Click "Add queue"
--
-- ============================================================================
-- RUNNING
-- ============================================================================
--
--    cargo run --bin run_eventflux examples/rabbitmq_to_log.eventflux
--
-- ============================================================================
-- TESTING
-- ============================================================================
--
-- Publish test messages in the RabbitMQ Management UI:
-- 1. Go to "Queues" → "event-queue" → "Publish message"
-- 2. Payload:
--
--    {"id":"evt-001","name":"temperature","value":23.5}
--
-- You should see a log line with the [LOG] prefix followed by the event as
-- JSON. The sink writes at info level, so info logging must be enabled.
--
-- ============================================================================

-- Input stream. Reads JSON events from a RabbitMQ queue.
CREATE STREAM EventInput (
    id STRING,
    name STRING,
    value DOUBLE
) WITH (
    type = 'source',
    extension = 'rabbitmq',
    format = 'json',
    "rabbitmq.host" = 'localhost',
    "rabbitmq.port" = '5672',
    "rabbitmq.queue" = 'event-queue',
    "rabbitmq.username" = 'guest',
    "rabbitmq.password" = 'guest'
);

-- Output stream. Logs events to the console with the built in log sink.
CREATE STREAM EventOutput (
    id STRING,
    name STRING,
    value DOUBLE
) WITH (
    type = 'sink',
    extension = 'log',
    format = 'json'
);

-- Forward every event to the log sink.
INSERT INTO EventOutput
SELECT id, name, value
FROM EventInput;
